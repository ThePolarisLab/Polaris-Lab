# Polaris runtime profile: development, staging, or production
POLARIS_ENV=development

# Local development defaults to sqlite:///./polaris.db when DATABASE_URL is omitted.
# Hosted staging and production must use persistent PostgreSQL. Do not use /tmp SQLite on Render.
DATABASE_URL=sqlite:///./polaris.db

# Public service metadata
POLARIS_SERVICE_NAME=Polaris Chief of Staff API
POLARIS_VERSION=0.8.0-alpha

# Founding builder organization context for local bootstrap only.
# AuthenticatedPrincipal.organization_id is authoritative for tenant-owned data.
POLARIS_ORGANIZATION_SLUG=mor-logistics

# Comma-separated frontend origins permitted by CORS
POLARIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted environments must set this to the deployed frontend origin.
POLARIS_FRONTEND_URL=http://localhost:5173

# Production authentication. Never commit real values.
# POLARIS_SESSION_SECRET must be at least 32 characters in production/staging.
POLARIS_SESSION_SECRET=
POLARIS_ACCESS_TOKEN_TTL_SECONDS=900
POLARIS_REFRESH_TOKEN_TTL_SECONDS=1209600

# One-time first-admin bootstrap for hosted production/staging.
# Set these only long enough to complete POST /api/v1/auth/bootstrap, then remove POLARIS_BOOTSTRAP_SECRET.
POLARIS_BOOTSTRAP_ADMIN_EMAIL=
POLARIS_BOOTSTRAP_SECRET=

# One-time legacy adoption only. Leave blank for clean databases.
# Set all three only after backup and explicit verification that every unowned
# legacy tenant row belongs to this organization. Remove after migration succeeds.
POLARIS_TENANT_BACKFILL_ORGANIZATION_ID=
POLARIS_TENANT_BACKFILL_ORGANIZATION_SLUG=
POLARIS_TENANT_BACKFILL_ORGANIZATION_NAME=

# QuickBooks production adapter values live in .env.quickbooks.example.
# Never commit real Intuit credentials, OAuth tokens, authorization codes, or realm IDs.