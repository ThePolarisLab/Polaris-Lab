# Dedicated Polaris QuickBooks Online OAuth application
# Copy these names into chief-of-staff/backend/.env or a production secret manager.
# Never commit real values.
POLARIS_QBO_CLIENT_ID=
POLARIS_QBO_CLIENT_SECRET=
POLARIS_QBO_REDIRECT_URI=https://YOUR-POLARIS-DOMAIN/api/v1/connectors/quickbooks/oauth/callback
POLARIS_QBO_OAUTH_STATE_SECRET=
POLARIS_QBO_TOKEN_ENCRYPTION_KEY=
POLARIS_FRONTEND_URL=https://YOUR-POLARIS-FRONTEND-DOMAIN

# Hosted staging and production must use persistent PostgreSQL before QuickBooks authorization.
# Do not use sqlite:////tmp/polaris.db for live QuickBooks verification.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Generate local secrets with Python:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Refresh token and realm ID are deliberately absent. Polaris obtains and stores
# them itself after /api/v1/connectors/quickbooks/oauth/authorize completes.
