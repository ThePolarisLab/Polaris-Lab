# Dedicated Polaris QuickBooks Online OAuth application
# Copy these names into chief-of-staff/backend/.env or a production secret manager.
# Never commit real values.

# Hosted staging and production must use persistent PostgreSQL before QuickBooks authorization.
# Do not use sqlite:////tmp/polaris.db for live QuickBooks verification.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Mode. Use production for Render/live company. Sandbox is allowed only in development/test.
POLARIS_QBO_ENVIRONMENT=production

# Intuit OAuth application values. Required for authorize, callback, refresh, verification, sync, and disconnect.
POLARIS_QBO_CLIENT_ID=
POLARIS_QBO_CLIENT_SECRET=
POLARIS_QBO_REDIRECT_URI=https://YOUR-POLARIS-DOMAIN/api/v1/connectors/quickbooks/oauth/callback
POLARIS_QBO_OAUTH_STATE_SECRET=
POLARIS_QBO_TOKEN_ENCRYPTION_KEY=

# Expected live company identity. Polaris normalizes case and repeated whitespace only.
POLARIS_QBO_EXPECTED_COMPANY_NAME=MOR LOGISTICS MANITOBA LIMITED

# Frontend redirect after OAuth callback. Hosted environments must not use localhost.
POLARIS_FRONTEND_URL=https://YOUR-POLARIS-FRONTEND-DOMAIN

# Optional QuickBooks transport tuning.
POLARIS_QBO_MINOR_VERSION=75
POLARIS_QBO_REQUEST_TIMEOUT_SECONDS=20
POLARIS_QBO_MAX_ATTEMPTS=3
POLARIS_QBO_RETRY_BASE_SECONDS=0.25

# Optional endpoint overrides for tests/sandbox only. Leave unset in production.
# POLARIS_QBO_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# POLARIS_QBO_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# POLARIS_QBO_REVOKE_URL=https://developer.api.intuit.com/v2/oauth2/tokens/revoke

# Generate local secrets with Python:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Refresh token and realm/company ID are deliberately absent. Polaris obtains and stores
# them itself after /api/v1/connectors/quickbooks/oauth/authorize-url is fetched by an
# authenticated connector administrator and the returned Intuit authorization URL completes.
